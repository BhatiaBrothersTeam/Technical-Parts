# Copy this file to .env.local and fill in real values before deploying.
# Never commit real values. All of these are read by server code only; none
# of them may ever be given a NEXT_PUBLIC_ prefix.

# --- WooCommerce catalogue (your own Hostinger WordPress site) ---
# When WOOCOMMERCE_STORE_URL is set, products, categories and brands come from
# WooCommerce (cached for 5 minutes). When it is empty, the bundled demo
# products are used.
# Example: https://shop.your-domain.com
WOOCOMMERCE_STORE_URL=

# Read-only REST API key: WooCommerce > Settings > Advanced > REST API,
# Permissions: Read. Without a key the site falls back to the public Store API.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Optional. Comma-separated extra hosts that serve product photos (for example a
# CDN such as i0.wp.com). Photos on any other host are replaced by a category
# photo so a stray URL can never break a page. The store host is always allowed.
WOOCOMMERCE_IMAGE_HOSTS=

# Secret used when creating the WooCommerce webhook (Product created / updated /
# deleted) that points at https://your-site/api/revalidate. Lets product edits
# appear immediately instead of after the 5-minute cache.
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Leads (bb-leads WordPress plugin) ---
# When BB_LEADS_ENDPOINT is set, every enquiry and uploaded file is sent to the
# plugin on WordPress. When empty, leads are saved to the local data/ folder
# (development only).
# Example: https://shop.your-domain.com/wp-json/bb-leads/v1/leads
BB_LEADS_ENDPOINT=

# At least 32 random characters. Must be identical to BB_LEADS_PROXY_SECRET in
# the WordPress wp-config.php. Generate one with: openssl rand -hex 32
BB_LEADS_PROXY_SECRET=
